<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    >
    <FrameLayout
        android:id="@+id/container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >

        <LinearLayout
            android:id="@+id/info"
            android:layout_width="match_parent"
            android:layout_height="76dp"
            android:layout_gravity="center_horizontal|bottom"
            android:layout_marginHorizontal="180dp"
            android:layout_marginBottom="24dp"
            android:orientation="horizontal"
            android:background="@drawable/bg_panel_rounded"
            android:padding="10dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logo"
                android:layout_width="88dp"
                android:layout_height="56dp"
                android:background="@android:color/transparent"
                android:padding="5dp"
                android:scaleType="fitCenter"
                />
            <LinearLayout
                    android:id="@+id/main"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginStart="4dp"
                    android:gravity="start|center_vertical"
                    android:orientation="vertical"
                    android:paddingVertical="3dp"
                    android:paddingEnd="8dp">

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:textColor="@color/title_blur"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <androidx.appcompat.widget.AppCompatTextView
                        android:id="@+id/desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start"
                        android:gravity="start"
                        android:singleLine="true"
                        android:textColor="@color/description_blur"
                        android:textSize="13sp" />

                    <!-- EPG 进度条 -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/epg_time_start"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/description_blur"
                            android:textSize="10sp"
                            android:fontFeatureSettings="tnum"
                            android:text="19:00"
                            android:visibility="gone" />
                        <ProgressBar
                            android:id="@+id/epg_progress"
                            style="?android:attr/progressBarStyleHorizontal"
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="3dp"
                            android:layout_marginHorizontal="4dp"
                            android:max="100"
                            android:progress="55"
                            android:progressDrawable="@drawable/epg_progress_drawable"
                            android:visibility="gone" />
                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/epg_time_end"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/description_blur"
                            android:textSize="10sp"
                            android:fontFeatureSettings="tnum"
                            android:text="19:30"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
