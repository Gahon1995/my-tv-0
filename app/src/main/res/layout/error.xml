<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/error"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <com.lizongying.mytv0.view.GlassPanelLayout
        android:id="@+id/error_card"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:glassRadius="24dp">

        <LinearLayout
            android:id="@+id/main"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="380dp"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingStart="44dp"
            android:paddingEnd="44dp"
            android:paddingTop="28dp"
            android:paddingBottom="28dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/logo"
                android:src="@drawable/ic_signal_error"
                android:layout_width="48dp"
                android:layout_height="48dp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                tools:text="信号中断，正在自动恢复"
                android:textSize="20sp" />

            <androidx.appcompat.widget.AppCompatTextView
                android:id="@+id/sub_msg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/text_dim"
                android:text="@string/auto_retry_hint"
                android:textSize="14sp" />

            <ProgressBar
                android:id="@+id/retry_spinner"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_marginTop="14dp"
                android:indeterminateTint="@color/accent" />
        </LinearLayout>
    </com.lizongying.mytv0.view.GlassPanelLayout>
</FrameLayout>
