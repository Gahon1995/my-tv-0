<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/setting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:focusable="false">

    <com.lizongying.mytv0.view.GlassPanelLayout
        android:id="@+id/setting_panel"
        android:layout_width="880dp"
        android:layout_height="560dp"
        android:layout_gravity="center"
        app:glassRadius="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <!-- 左侧导航 -->
            <LinearLayout
                android:id="@+id/side"
                android:layout_width="230dp"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="8dp"
                    android:paddingBottom="16dp">

                    <androidx.appcompat.widget.AppCompatImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:src="@mipmap/ic_launcher" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_primary"
                            android:textStyle="bold"
                            android:text="@string/app_name"
                            android:textSize="16sp" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/version_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_dim"
                            android:text=""
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/nav_source"
                    style="@style/SettingNav"
                    android:text="@string/setting_nav_source"
                    android:drawableStart="@drawable/ic_nav_source" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/nav_play"
                    style="@style/SettingNav"
                    android:text="@string/setting_nav_play"
                    android:drawableStart="@drawable/ic_nav_play" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/nav_display"
                    style="@style/SettingNav"
                    android:text="@string/setting_nav_display"
                    android:drawableStart="@drawable/ic_nav_display" />

                <androidx.appcompat.widget.AppCompatTextView
                    android:id="@+id/nav_about"
                    style="@style/SettingNav"
                    android:text="@string/setting_nav_about"
                    android:drawableStart="@drawable/ic_nav_about" />
            </LinearLayout>

            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:background="@color/glass_border" />

            <!-- 右侧内容 -->
            <FrameLayout
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent">

                <!-- ① 直播源 -->
                <ScrollView
                    android:id="@+id/group_source"
                    style="@style/SettingGroup">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/SettingSection"
                            android:text="@string/setting_nav_source" />

                        <LinearLayout
                            android:id="@+id/confirm_config"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:background="@drawable/bg_item_selector"
                            android:padding="13dp">

                            <androidx.appcompat.widget.AppCompatTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/text_primary"
                                android:text="@string/config_address"
                                android:textSize="15sp" />

                            <androidx.appcompat.widget.AppCompatTextView
                                android:id="@+id/config_url_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:background="@drawable/bg_input_box"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:textColor="@color/text_tertiary"
                                android:singleLine="true"
                                android:ellipsize="middle"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_config_auto_load"
                            style="@style/SettingSwitch"
                            android:text="@string/title_config_auto_load" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/remote_settings"
                            style="@style/SettingButton"
                            android:text="@string/server" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_default_like"
                            style="@style/SettingSwitch"
                            android:text="@string/title_default_like" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_show_all_channels"
                            style="@style/SettingSwitch"
                            android:text="@string/show_all_channels" />
                    </LinearLayout>
                </ScrollView>

                <!-- ② 播放设置 -->
                <ScrollView
                    android:id="@+id/group_play"
                    style="@style/SettingGroup"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/SettingSection"
                            android:text="@string/setting_nav_play" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_soft_decode"
                            style="@style/SettingSwitch"
                            android:text="@string/soft_decode" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_repeat_info"
                            style="@style/SettingSwitch"
                            android:text="@string/title_repeat_info" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_channel_reversal"
                            style="@style/SettingSwitch"
                            android:text="@string/title_channel_reversal" />
                    </LinearLayout>
                </ScrollView>

                <!-- ③ 界面外观 -->
                <ScrollView
                    android:id="@+id/group_display"
                    style="@style/SettingGroup"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/SettingSection"
                            android:text="@string/setting_nav_display" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_glass_blur"
                            style="@style/SettingSwitch"
                            android:text="@string/glass_effect" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_elder_mode"
                            style="@style/SettingSwitch"
                            android:text="@string/elder_mode" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_channel_num"
                            style="@style/SettingSwitch"
                            android:text="@string/title_channel_num" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_time"
                            style="@style/SettingSwitch"
                            android:text="@string/title_time" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_display_seconds"
                            style="@style/SettingSwitch"
                            android:text="@string/display_seconds" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_compact_menu"
                            style="@style/SettingSwitch"
                            android:text="@string/compact_menu" />
                    </LinearLayout>
                </ScrollView>

                <!-- ④ 更新与关于 -->
                <ScrollView
                    android:id="@+id/group_about"
                    style="@style/SettingGroup"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <androidx.appcompat.widget.AppCompatTextView
                            style="@style/SettingSection"
                            android:text="@string/setting_nav_about" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/check_version"
                            style="@style/SettingButton"
                            android:text="@string/check_version" />

                        <androidx.appcompat.widget.SwitchCompat
                            android:id="@+id/switch_boot_startup"
                            style="@style/SettingSwitch"
                            android:text="@string/title_boot_startup" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/clear"
                            style="@style/SettingButton"
                            android:text="@string/clear" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/appreciate"
                            style="@style/SettingButton"
                            android:text="@string/appreciate" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/exit"
                            style="@style/SettingButton"
                            android:text="@string/exit" />

                        <androidx.appcompat.widget.AppCompatTextView
                            android:id="@+id/version"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:paddingStart="13dp"
                            android:textColor="@color/text_dim"
                            android:text=""
                            android:textSize="12sp" />
                    </LinearLayout>
                </ScrollView>
            </FrameLayout>
        </LinearLayout>
    </com.lizongying.mytv0.view.GlassPanelLayout>
</FrameLayout>
